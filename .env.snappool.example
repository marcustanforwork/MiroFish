# SnapPool launch simulation: see ~/source/snappool/docs/market-simulation/PLAN.md
# No LLM_BOOST_* lines on purpose: if present, the Reddit half runs on them instead.

# The $10-limit OpenRouter key made for this, never the snappool .env.local key
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ontology, personas, config and report.
#   Pilot:     deepseek/deepseek-v4.1-flash-1017@preset/snappool-deepseek
#   Main run:  deepseek/deepseek-v4-pro-0813@preset/snappool-deepseek
#   Run 2:     deepseek/deepseek-v4.1-flash-1017@preset/snappool-deepseek
LLM_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017@preset/snappool-deepseek

# The agents (the SnapPool patch to backend/scripts/run_parallel_simulation.py).
#   Pilot and main run:  deepseek/deepseek-v4.1-flash-1017@preset/snappool-deepseek
#   Run 2:               openai/gpt-6-luna
LLM_SIM_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017@preset/snappool-deepseek
# DeepSeek thinks by default; a social post does not need it. Fallback if refused: minimal
LLM_SIM_REASONING_EFFORT=none

ZEP_API_KEY=
